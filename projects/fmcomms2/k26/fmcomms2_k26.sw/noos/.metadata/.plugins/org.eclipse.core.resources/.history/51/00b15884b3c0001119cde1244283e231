int main(void)
{
    /* 1) RS422/PC link first - boot log lines (incl. the AD9361 result, or
     *    the last line before a hang) reach the app live. */
    BoardApp_InitLink();

    /* 2) AD9361. A failure is NO LONGER fatal (used to halt here, which
     *    also killed the PC link - the app then only saw an orange light
     *    and no spectrum, with the reason visible only on the JTAG/UART
     *    console). Now: RF spectrum disabled, everything else keeps
     *    working, and the reason is reported to the app (boot log +
     *    "DIAG"). The F1956 init in BoardApp_Init() reclaims the shared
     *    SPI0 controller either way. */
    if (Ad9361_Bringup() != XST_SUCCESS) {
        BoardLog(BOARD_LOG_ERROR, "Loi: AD9361 khoi tao that bai - tat pho RF, cac chuc nang khac van chay.");
    }

    /* 3) everything else */
    BoardApp_Init();

    while (1) {
        BoardApp_PollOnce();
    }

    return 0;
}
