/* See ad9361_phy.h. */
struct ad9361_rf_phy *g_ad9361_phy = NULL;
ad9361_rf_status_t    g_rf_status  = { 0 };
uint8_t               g_ad9361_ok  = 0U;
int32_t               g_ad9361_init_status = 0;

/* AD9361 bring-up. Local to main.c on purpose (see file header) - not a
 * separate module. Returns XST_SUCCESS/XST_FAILURE and records the result
 * in g_ad9361_ok / g_ad9361_init_status. On failure main() continues with
 * the RF spectrum disabled (see main()). */
#define AD9361_INIT_RETRIES 5

static int Ad9361_Bringup(void)
{
    int32_t status;
    u8  lo_state;
    u64 lo_freq;
    u32 samp_freq, bandwidth;
    u32 rx_samp_freq;
    int32_t rx_gain;
    uint8_t rx_gain_mode;

    Xil_ICacheEnable();
    Xil_DCacheEnable();

    default_init_param.gpio_resetb.number  = GPIO_RESET_PIN;
    default_init_param.gpio_sync.number    = -1;
    default_init_param.gpio_cal_sw1.number = -1;
    default_init_param.gpio_cal_sw2.number = -1;

    BoardLog(BOARD_LOG_INFO, "AD9361: bat dau khoi tao (ad9361_init)...");
    no_os_mdelay(200);   /* cho clock 40 MHz / nguon AD9361 on dinh sau khi bat nguon */
    for (int attempt = 1; attempt <= AD9361_INIT_RETRIES; attempt++) {
        g_ad9361_phy = NULL;
        status = ad9361_init(&g_ad9361_phy, &default_init_param);
        if (status >= 0 && g_ad9361_phy != NULL)
            break;
        BoardLog(BOARD_LOG_WARN, "AD9361: lan %d/%d that bai (status=%d), thu lai...",
                 attempt, AD9361_INIT_RETRIES, (int)status);
        no_os_mdelay(500);
    }
    g_ad9361_init_status = status;
    if (status < 0 || g_ad9361_phy == NULL) {
        BoardLog(BOARD_LOG_ERROR, "Loi: ad9361_init() that bai (status=%d)", (int)status);
        if (g_ad9361_init_status == 0) {
            g_ad9361_init_status = -1;   /* NULL phy with status 0 */
        }
        return XST_FAILURE;
    }

    ad9361_tx_lo_powerdown(g_ad9361_phy, 1);
    ad9361_set_tx_fir_config(g_ad9361_phy, tx_fir_config);
    ad9361_set_rx_fir_config(g_ad9361_phy, rx_fir_config);

    /* axi_adc_init() for the RX core already happened inside ad9361_init()
     * above - it uses default_init_param.rx_adc_init (&rx_adc_init, set
     * above) internally (see noos/drivers/rf-transceiver/ad9361/
     * ad9361_api.c: ad9361_init() calls axi_adc_init(&phy->rx_adc,
     * init_param->rx_adc_init)). Only the TX DAC core needs an explicit
     * call here, exactly like the reference does. */
    axi_dac_init(&g_ad9361_phy->tx_dac, &tx_dac_init);
    axi_dac_set_datasel(g_ad9361_phy->tx_dac, -1, AXI_DAC_DATA_SEL_DMA);

    /* TODO(confirm): see file header - ADI reference default, not a value
     * from your spec. */
    ad9361_set_tx_sampling_freq(g_ad9361_phy, 60000000);
    ad9361_set_rx_sampling_freq(g_ad9361_phy, 60000000);

    ad9361_set_rx_gain_control_mode(g_ad9361_phy, 0, RF_GAIN_MGC);
    ad9361_set_rx_gain_control_mode(g_ad9361_phy, 1, RF_GAIN_MGC);
    ad9361_set_rx_rf_gain(g_ad9361_phy, 0, 0);
    ad9361_set_rx_rf_gain(g_ad9361_phy, 1, 0);

    /* Short bring-up summary. 32-bit prints only (%u/%d) - avoids the
     * 64-bit xil_printf formatting the old reference debug console got
     * wrong (see the first integration pass's INTEGRATION_NOTES.md);
     * frequencies here are well under 4.29 GHz so the cast to unsigned int
     * is safe. */
    ad9361_get_tx_lo_power(g_ad9361_phy, &lo_state);
    BoardLog(BOARD_LOG_INFO, "AD9361: LO TX %s", lo_state ? "ON" : "OFF");
    ad9361_get_rx_lo_freq(g_ad9361_phy, &lo_freq);
    BoardLog(BOARD_LOG_INFO, "AD9361: LO RX = %u Hz", (unsigned int)lo_freq);
    ad9361_get_rx_rf_gain(g_ad9361_phy, 0, &rx_gain);
    BoardLog(BOARD_LOG_INFO, "AD9361: RX1 gain = %d dB", (int)rx_gain);
    ad9361_get_tx_sampling_freq(g_ad9361_phy, &samp_freq);
    BoardLog(BOARD_LOG_INFO, "AD9361: TX Fs = %u Hz", (unsigned int)samp_freq);
    ad9361_get_rx_rf_bandwidth(g_ad9361_phy, &bandwidth);
    BoardLog(BOARD_LOG_INFO, "AD9361: RX RF BW = %u Hz", (unsigned int)bandwidth);
    ad9361_get_rx_sampling_freq(g_ad9361_phy, &rx_samp_freq);
    BoardLog(BOARD_LOG_INFO, "AD9361: RX Fs = %u Hz", (unsigned int)rx_samp_freq);
    rx_gain_mode = 0U;
    ad9361_get_rx_gain_control_mode(g_ad9361_phy, 0, &rx_gain_mode);

    /* Cache the RX config NOW, while this code still owns SPI0 - the RF
     * status report sent to the Qt app ("RFST", cmd_dispatcher.c) is built
     * from this cache only, never from a live SPI read (see ad9361_phy.h). */
    g_rf_status.rx_lo_hz    = (uint64_t)lo_freq;
    g_rf_status.rx_fs_hz    = (uint32_t)rx_samp_freq;
    g_rf_status.rx_bw_hz    = (uint32_t)bandwidth;
    g_rf_status.rx1_gain_db = rx_gain;
    g_rf_status.gain_mode   = rx_gain_mode;
    g_rf_status.valid       = 1U;

    BoardLog(BOARD_LOG_INFO, "AD9361: khoi tao xong.");
    g_ad9361_ok = 1U;

    return XST_SUCCESS;
}
